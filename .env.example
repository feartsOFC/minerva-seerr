# minerva-seerr — copie para .env e proteja:  cp .env.example .env && chmod 600 .env
# O .env nunca vai para o git. Tudo aqui tem padrão; o mínimo para começar é MINERVA_URL.

# Endereço pelo qual as pessoas abrem o app (usado nos links de configuração).
# Ex.: http://192.168.1.50:8000  ou  https://minerva.minha.casa (atrás de um proxy reverso)
MINERVA_URL=http://localhost:8000

# Porta publicada no host
MINERVA_PORTA=8000

# Se houver proxy reverso com HTTPS (Caddy, nginx, Traefik): IP dele, para o app confiar no X-Forwarded-Proto
# e marcar o cookie de sessão como Secure. Vários: separados por vírgula.
MINERVA_PROXY_IPS=127.0.0.1

# Índice do Minerva Archive (listagem plana dos .torrent na raiz do CDN)
MINERVA_INDICE_URL=https://cdn.minerva-archive.org/

# Coleções indexadas, separadas por ";". Vazio = padrão (Xbox 360 + DLC/updates, PS2, SNES, N64). "*" = catálogo inteiro.
MINERVA_COLECOES=

# Trackers em cada magnet: 3, 10 ou 0 (= todos os do torrent)
MINERVA_TRACKERS=10

# qBittorrent (Web UI ligado). Usuário/senha só se o IP do app não estiver na whitelist do Web UI.
# Também dá para trocar o endereço depois em Ajustes.
QBIT_URL=http://localhost:8080
QBIT_USUARIO=
QBIT_SENHA=

# Token do worker de entrega (opcional). Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MINERVA_WORKER_TOKEN=

# IGDB (opcional; capas e fichas extras). App em dev.twitch.tv, tipo Confidencial, redirect http://localhost.
# Também dá para colar pela tela de Ajustes ou pelo link de configuração.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
